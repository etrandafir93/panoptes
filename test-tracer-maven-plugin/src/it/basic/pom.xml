<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.etrandafir.panoptes.it</groupId>
    <artifactId>test-tracer-it-basic</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <description>
        Phase 5 IT fixture for test-tracer-maven-plugin. Pre-populates NDJSON files with realistic
        OTLP-shaped spans (one test trace + one orphan) then runs `report` and asserts the HTML site.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>seed-spans</id>
                        <phase>process-test-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/test-tracer"/>
                                <!--
                                  Two NDJSON lines:
                                  1) Root span with test.method attribute → renders as test entry
                                  2) Orphan span (no parentSpanId, different traceId, no test.method)
                                -->
                                <echo file="${project.build.directory}/test-tracer/spans.ndjson" append="false"
                                      message='{"traceId":"aaaa0000000000000000000000000001","spanId":"bbbb000000000001","name":"test:MyTest#myMethod","kind":"SPAN_KIND_INTERNAL","startTimeUnixNano":"1000000000","endTimeUnixNano":"2000000000","status":{"code":"STATUS_CODE_OK"},"attributes":[{"key":"test.class","value":{"stringValue":"MyTest"}},{"key":"test.method","value":{"stringValue":"myMethod"}},{"key":"test.status","value":{"stringValue":"PASSED"}}],"events":[],"resource":{"attributes":[]},"scope":{"name":"test-tracer"}}&#10;{"traceId":"cccc0000000000000000000000000002","spanId":"dddd000000000002","name":"orphan-span","kind":"SPAN_KIND_INTERNAL","startTimeUnixNano":"3000000000","endTimeUnixNano":"3500000000","status":{"code":"STATUS_CODE_UNSET"},"attributes":[],"events":[],"resource":{"attributes":[]},"scope":{"name":"test-tracer"}}&#10;'/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.etrandafir.panoptes</groupId>
                <artifactId>test-tracer-maven-plugin</artifactId>
                <version>@project.version@</version>
                <executions>
                    <execution>
                        <id>tt-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
