<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.etrandafir.panoptes.it</groupId>
    <artifactId>test-tracer-it-basic</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <description>
        Phase 4 IT fixture for test-tracer-maven-plugin. Pre-populates a fake NDJSON file under
        target/test-tracer/ then runs the `report` aggregator goal and asserts the HTML landed.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <!--
              Seed a fake spans.ndjson before `report` runs so we don't need the JUnit 5 extension
              and the Spring Boot starter wired here — those are exercised in their own modules'
              unit/integration tests. This IT proves the plugin glob-matches and renders.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>noop</id>
                        <phase>validate</phase>
                        <goals><goal>parse-version</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>seed-spans</id>
                        <phase>process-test-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/test-tracer"/>
                                <echo file="${project.build.directory}/test-tracer/spans.ndjson"
                                      message='{"traceId":"abc","spanId":"def","name":"seed"}${line.separator}'/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.etrandafir.panoptes</groupId>
                <artifactId>test-tracer-maven-plugin</artifactId>
                <version>@project.version@</version>
                <executions>
                    <execution>
                        <id>tt-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
