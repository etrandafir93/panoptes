<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.etrandafir.panoptes</groupId>
        <artifactId>test-tracer-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>test-tracer-e2e</artifactId>

    <description>
        End-to-end sample project demonstrating the panoptes test-tracer pipeline.
        A plain Java + Spring Boot application that uses Micrometer Tracing with the
        OTel bridge. Tests are instrumented by test-tracer-junit5 and the spring-boot
        starter wires the NDJSON exporter. After tests run, test-tracer-maven-plugin
        generates a static HTML report in target/test-tracer/site/.
    </description>

    <dependencies>
        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Actuator brings in Micrometer + tracing autoconfiguration (Tracer bean) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Micrometer Tracing OTel bridge — bridges Micrometer Tracer → OTel SDK -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>

        <!-- OTel SDK — satisfies the 'provided' scope in test-tracer-core and
             supplies the SdkTracerProvider that Spring Boot autoconfigures -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
        </dependency>

        <!-- Panoptes: wires the NDJSON exporter as a Spring bean -->
        <dependency>
            <groupId>com.etrandafir.panoptes</groupId>
            <artifactId>test-tracer-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Panoptes: JUnit 5 extension that opens a root span per test -->
        <dependency>
            <groupId>com.etrandafir.panoptes</groupId>
            <artifactId>test-tracer-junit5</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Pure Java module — disable the Kotlin compile phases from the parent -->
        <sourceDirectory>src/main/java</sourceDirectory>
        <testSourceDirectory>src/test/java</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals><goal>compile</goal></goals>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals><goal>testCompile</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Keep going even if some tests fail — the report goal needs
                         to run in verify phase so we can see the failures in the HTML -->
                    <testFailureIgnore>true</testFailureIgnore>
                </configuration>
            </plugin>

            <!-- Generate the HTML report after tests have produced spans.ndjson -->
            <plugin>
                <groupId>com.etrandafir.panoptes</groupId>
                <artifactId>test-tracer-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>panoptes-report</id>
                        <goals><goal>report</goal></goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
